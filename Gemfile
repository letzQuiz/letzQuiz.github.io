source "https://rubygems.org"

# The site deploys through GitHub Actions (.github/workflows/jekyll.yml)
# with the GitHub Pages gem set and the Minimal Mistakes theme pulled in
# via jekyll-remote-theme (remote_theme in _config.yml). Build locally with:
#
#     bundle exec jekyll serve
#
